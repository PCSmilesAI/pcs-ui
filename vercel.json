{ "version": 2, "builds": [ { "src": "api/**/*.js", "use": "@vercel/node@1.15.0" }, { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } } ], "routes": [ { "src": "/api/(.*)", "dest": "/api/$1" }, { "src": "/(.*)", "has": [ { "type": "header", "key": "accept", "value": "text/html" } ], "dest": "/index.html" } ] }