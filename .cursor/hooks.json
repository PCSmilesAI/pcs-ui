{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "afterAgentThought": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "preCompact": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "stop": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 scripts/append_log.py"
      }
    ]
  }
}
